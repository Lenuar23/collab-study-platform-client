<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.messenger.ui.controllers.chat.ChatSidebarController"
      styleClass="chat-sidebar"
      spacing="8.0"
      >

    <padding>
        <Insets top="10" right="5" bottom="10" left="10"/>
    </padding>

    <Label text="Conversations" styleClass="sidebar-section-title"/>
    <ListView fx:id="conversationsList" VBox.vgrow="ALWAYS"/>

    <Separator/>

    <Label text="Start direct chat" styleClass="sidebar-section-title"/>
    <HBox spacing="5.0">
        <TextField fx:id="directUserIdField"
                   promptText="Other user ID"
                   HBox.hgrow="ALWAYS"/>
        <Button text="Open" onAction="#onOpenDirectChat"/>
    </HBox>

    <Separator/>

    <Label text="Create group chat"/>
    <TextField fx:id="groupNameField" promptText="Group name (optional)"/>
    <TextField fx:id="groupParticipantsField" promptText="Participant IDs (comma separated)"/>
    <Button text="Create group" onAction="#onCreateGroup"/>

    <Separator/>

    <Label text="Manage participants"/>
    <HBox spacing="5.0">
        <TextField fx:id="addParticipantField" promptText="User ID" HBox.hgrow="ALWAYS"/>
        <Button text="Add" onAction="#onAddParticipant"/>
        <Button text="Remove" onAction="#onRemoveParticipant"/>
    </HBox>

    <Button text="Show participants" onAction="#onShowParticipants"/>

</VBox>
