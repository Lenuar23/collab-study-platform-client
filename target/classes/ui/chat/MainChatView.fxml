<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.fxml.FXML?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.messenger.ui.controllers.chat.MainChatController"
            styleClass="app-root"
            >
    <left>
        <fx:include source="ChatSidebarView.fxml" fx:id="sidebar"/>
    </left>

    <top>
        <fx:include source="ChatHeaderView.fxml" fx:id="header"/>
    </top>

    <center>
        <fx:include source="ChatMessageView.fxml" fx:id="messages"/>
    </center>

</BorderPane>
