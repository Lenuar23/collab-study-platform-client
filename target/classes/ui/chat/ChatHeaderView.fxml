<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.messenger.ui.controllers.chat.ChatHeaderController"
      spacing="8.0"
      alignment="CENTER_LEFT"
      styleClass="header-bar">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Conversation:" styleClass="header-label"/>
    <Label fx:id="activeConversationLabel" text="None"/>

    <Button text="Stats" onAction="#onShowStats"/>
    <Button text="Tasks" onAction="#onOpenTasks"/>
    <Button text="Participants" onAction="#onShowParticipants"/>

    <Pane HBox.hgrow="ALWAYS"/>

    <Label fx:id="currentUserLabel" text=""/>
    <Button text="Profile" onAction="#onOpenProfile"/>
    <Button text="Logout" onAction="#onLogout"/>

</HBox>
