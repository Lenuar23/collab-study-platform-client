<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.messenger.ui.controllers.chat.ChatMessageController"
            styleClass="messages-root">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <!-- список повідомлень -->
            <center>
                <ListView fx:id="messagesList"
                          prefWidth="600.0"
                          prefHeight="400.0" />
            </center>

            <!-- нижня панель: поле вводу + кнопки -->
            <bottom>
                <HBox spacing="8.0">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                    </padding>

                    <children>
                        <TextField fx:id="messageField"
                                   promptText="Type a message..."
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="Send"
                                onAction="#onSendMessage"/>

                        <Button text="Edit"
                                onAction="#onEditMessage"/>

                        <Button text="Delete"
                                onAction="#onDeleteMessage"/>
                    </children>
                </HBox>
            </bottom>

        </BorderPane>
    </children>
</AnchorPane>
